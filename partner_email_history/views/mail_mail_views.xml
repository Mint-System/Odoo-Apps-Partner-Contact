<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mail_tree" model="ir.ui.view">
        <field name="name">partner_email_history.view_mail_tree</field>
        <field name="model">mail.mail</field>
        <field name="inherit_id" ref="mail.view_mail_tree" />
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="default_order">date desc</attribute>
            </list>
        </field>
    </record>

    <record id="view_mail_list" model="ir.ui.view">
        <field name="name">partner_email_history.view_mail_list</field>
        <field name="model">mail.mail</field>
        <field name="arch" type="xml">
            <list string="Emails">
                <field name="date" />
                <field name="subject" />
                <field name="author_id" string="User" />
                <field name="body" />
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state in ('sent', 'cancel')"
                    decoration-info="state=='outgoing'"
                    decoration-danger="state=='exception'"
                />
            </list>
        </field>
    </record>

    <record id="action_view_mail_mail_list" model="ir.actions.act_window">
        <field name="name">Emails</field>
        <field name="res_model">mail.mail</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_mail_list" />
        <field name="context">{}</field>
        <field name="search_view_id" ref="mail.view_mail_search" />
    </record>
</odoo>
