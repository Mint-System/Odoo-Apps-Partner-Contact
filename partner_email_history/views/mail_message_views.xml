<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_message_tree" model="ir.ui.view">
        <field name="name">partner_email_history.view_message_tree</field>
        <field name="model">mail.message</field>
        <field name="inherit_id" ref="mail.view_message_tree" />
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="default_order">date desc</attribute>
            </list>
        </field>
    </record>

    <record id="view_message_list" model="ir.ui.view">
        <field name="name">partner_email_history.view_message_list</field>
        <field name="model">mail.message</field>
        <field name="arch" type="xml">
            <list default_order="date desc">
                <field name="date" />
                <field name="subtype_id" string="Type" optional="hide" />
                <field name="subject" />
                <field name="author_id" />
                <field
                    name="notified_partner_ids"
                    widget="many2many_tags"
                    string="Recipients"
                />
                <field name="body_short" string="Body" class="o_field_truncate" />
                <field name="model" string="Model" />
                <field name="record_name" string="Document" />
                <button
                    name="action_open_document"
                    type="object"
                    class="oe_link"
                    icon="fa-file-text-o"
                    invisible="not model or res_id == 0"
                    string="Open Document"
                />
            </list>
        </field>
    </record>

    <record id="action_view_mail_message_list" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">mail.message</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_message_list" />
        <field name="search_view_id" ref="mail.view_message_search" />
    </record>
</odoo>
