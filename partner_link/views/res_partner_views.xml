<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">crm_partner_multi_relation.view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <notebook position="before">
                <group colspan="2" name="group_links">
                    <field name="link_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="label_id" />
                            <field name="partner_id" />
                            <field name="comment" />
                        </list>
                    </field>
                </group>
            </notebook>

            <page name="contact_addresses" position="after">
                <page string="Backlinks" name="backlinks">
                    <p
                        colspan="2"
                    >This contact is linked by the following documents:</p>
                    <group
                        string="Contacts"
                        name="group_source_partner_links"
                        invisible="not source_partner_link_ids"
                    >
                        <field name="source_partner_link_ids" nolabel="1" colspan="2">
                            <list editable="bottom" create="false" delete="false">
                                <field name="label_id" />
                                <field name="source_partner_id" />
                                <field name="comment" />
                            </list>
                        </field>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
